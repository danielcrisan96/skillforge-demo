# Build Next.js (in Next 16, `next dev` scrie in .next/dev, separat de build)
/.next/
/out/
/build

# Teste
/coverage

# TypeScript
*.tsbuildinfo
# Generat automat la fiecare `next dev` / `next build`, nu se comite.
next-env.d.ts

# Deploy
.vercel

# Loguri
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

